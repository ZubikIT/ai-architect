# LLM — OpenAI-совместимый эндпоинт (в проде: vLLM + Qwen3.5, ADR-0002/0003)
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=not-needed
SUFLER_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# 0 = офлайн-демо без LLM (extractive fallback), 1 = с LLM
SUFLER_USE_LLM=1

# данные и модели
SUFLER_DATA_DIR=data/lpa
SUFLER_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
SUFLER_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# retrieval (урок 06)
SUFLER_TOP_K=20
SUFLER_TOP_CTX=5

# мультиагентный слой — «цифровые сотрудники» (ADR-0015)
SUFLER_MAS=1
SUFLER_MAS_MAX_STEPS=6            # потолок шагов цикла (LLM06 Unbounded Consumption)
SUFLER_MAS_MAX_TOOLS=4            # потолок вызовов инструментов на запрос
SUFLER_MAS_TOKEN_BUDGET=6000      # бюджет контекста на запрос, оценочно
SUFLER_MAS_FANOUT=2               # сколько ролей опрашивать при низкой уверенности
# checkpointer состояния; без переменной — in-memory (демо и тесты)
# DATABASE_URL=postgresql://platform:***@localhost:5432/platform
