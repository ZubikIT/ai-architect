{"version": 2, "width": 100, "height": 34, "timestamp": 1789746249, "env": {"SHELL": "/bin/bash", "TERM": "tmux-256color"}}
[0.240099, "o", "\u001b[H\u001b[J\u001b[3J"]
[0.240733, "o", "\u001b[1m\u001b[36mПод капотом: замеры, на которых стоят решения\u001b[0m\r\n\u001b[2m# ни одной цифры из презентации — всё считается здесь и сейчас\u001b[0m\r\n"]
[1.042131, "o", "\r\n\u001b[1m\u001b[36m1. Какие веса на самом деле отвечают\u001b[0m\r\n"]
[2.243981, "o", "\r\n\u001b[32m$ curl -s $GW/v1/models | jq '.data[] | {id, root}'\u001b[0m\r\n"]
[3.159331, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"zubr-2\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"root\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"/opt/models/Qwen3.8-27B-AWQ-INT4\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"qwen3.8-27b\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"root\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"/opt/models/Qwen3.8-27B-AWQ-INT4\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[4.66186, "o", "\u001b[2m# два идентификатора — одни веса: zubr-2 это продуктовое имя того же файла\u001b[0m\r\n"]
[5.463781, "o", "\u001b[2m# имена живут своей жизнью: сегодня утром здесь был алиас qwen3.6-35b\u001b[0m\r\n"]
[6.266063, "o", "\r\n\u001b[32m$ curl -s $GW/v1/chat/completions -d '{\"model\":\"qwen3.6-35b\", ...}'\u001b[0m\r\n"]
[7.182876, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"message\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"The model `qwen3.6-35b` does not exist.\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"code\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m404\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[8.6848, "o", "\u001b[2m# его переименовали — и всякий, кто просил модель по имени, получил 404\u001b[0m\r\n"]
[9.486833, "o", "\u001b[2m# вывод: имя модели не идентифицирует веса и не гарантирует даже своего существования\u001b[0m\r\n"]
[10.288897, "o", "\u001b[2m# источник истины — поле root, и только оно\u001b[0m\r\n"]
[11.090782, "o", "\r\n\u001b[1m\u001b[36m2. Смена весов: перемер, а не допущение\u001b[0m\r\n"]
[12.293014, "o", "\u001b[2m# все цифры приёмки сняты до обновления модели — значит их надо перемерить\u001b[0m\r\n"]
[13.095002, "o", "\u001b[2m# ниже сохранённый отчёт прогона в развёрнутой конфигурации\u001b[0m\r\n"]
[13.897181, "o", "\r\n\u001b[32m$ python3 - < docs/eval/raw-qwen38.json    # сравнение с прогоном до свопа\u001b[0m\r\n"]
[14.835051, "o", "  метрика                   MoE 3.6  dense 3.8\r\n  context recall              1.000      1.000\r\n  context precision           0.195      0.195\r\n  нарушений ACL               0.000      0.000\r\n  пометка об отмене           1.000      1.000\r\n  маршрутизация               1.000      1.000\r\n  токенов на запрос         739.286    755.143   ← изменилось\r\n"]
[17.342342, "o", "\u001b[2m# совпадение поразрядное — и это не удача: recall, precision, ACL и\u001b[0m\r\n"]
[18.144519, "o", "\u001b[2m# маршрутизация считаются без LLM, из совпадения с эталонными пунктами\u001b[0m\r\n"]
[18.946811, "o", "\u001b[2m# изменилось единственное, что зависит от генерации, — расход токенов\u001b[0m\r\n"]
[19.748719, "o", "\r\n\u001b[1m\u001b[36m3. Три графовых бэкенда на одном хосте — основание ADR-0028\u001b[0m\r\n"]
[20.95073, "o", "\u001b[2m# один корпус, один вызов, 30 повторов; вектор и реранк в замер не входят\u001b[0m\r\n"]
[21.752589, "o", "\r\n\u001b[32m$ python -m tools.graph_compare\u001b[0m\r\n"]
[23.752258, "o", "корпус: 19 чанков, 4 документов · роли ['legal'] · 30 повторов\r\nбэкенд           build             expand h=1             expand h=2            annotations\r\nin-memory          0 мс      0.00 / p95   0.01 мс      0.00 / p95   0.01 мс      0.00 / p95   0.00 мс\r\nneo4j            158 мс      1.15 / p95   2.48 мс      1.10 / p95   1.76 мс      1.19 / p95   3.53 мс\r\npostgres          78 мс      0.91 / p95   4.97 мс      0.83 / p95   1.69 мс      0.68 / p95   2.12 мс\r\nсовпадение выдачи (обход + аннотации), все чанки × 3 набора ролей:\r\n  neo4j        расхождений: 0\r\n  postgres     расхождений: 0\r\nround-trip'ов к БД на один обход:\r\n  neo4j     hops (запрос на каждый шаг фронтира — Cypher не принимает *1..$hops параметром)\r\n  postgres  1 (глубина — параметр рекурсии)\r\n"]
[26.330291, "o", "\u001b[2m# качество не разделило: расхождений ноль у обоих — значит выбирать по нему нельзя\u001b[0m\r\n"]
[27.132393, "o", "\r\n\u001b[1m\u001b[36m4. Где они всё-таки расходятся — на глубине\u001b[0m\r\n"]
[28.334552, "o", "\u001b[2m# на демо-корпусе цепочка отмен одна и в один хоп, разница не проявляется\u001b[0m\r\n"]
[29.137277, "o", "\u001b[2m# поэтому строится заведомо глубокая цепочка и меряется обход по глубине\u001b[0m\r\n"]
[29.939389, "o", "\r\n\u001b[32m$ python -m tools.graph_depth\u001b[0m\r\n"]
[32.518825, "o", "цепочка отмен глубиной 12, seed — исходная норма\r\n hops                  neo4j               postgres   найдено\r\n    1                0.99 мс                2.55 мс   1\r\n    2                2.66 мс                2.60 мс   2\r\n    4                4.87 мс                2.47 мс   4\r\n    6                6.94 мс                2.97 мс   6\r\n    8                8.97 мс                2.92 мс   8\r\n   11               12.74 мс                4.78 мс   11\r\n"]
[35.110798, "o", "\u001b[2m# Neo4j линеен: Cypher не принимает *1..$hops параметром, round-trip на каждый хоп\u001b[0m\r\n"]
[35.912815, "o", "\u001b[2m# рекурсивный CTE плоский: глубина — параметр запроса, поход в базу один\u001b[0m\r\n"]
[36.714767, "o", "\u001b[2m# решение приняла не эта таблица, а изоляция окружений и цена второго хранилища\u001b[0m\r\n"]
[37.516824, "o", "\u001b[2m# но без замера это было бы рассуждение, а не вывод\u001b[0m\r\n"]
[38.319261, "o", "\r\n\u001b[1m\u001b[36m5. Где система упирается — замер, а не ощущение\u001b[0m\r\n"]
[39.522453, "o", "\u001b[2m# закрытая петля: воркер шлёт запрос, ждёт ответ и шлёт следующий\u001b[0m\r\n"]
[40.327566, "o", "\u001b[2m# открытая петля выше насыщения меряет терпение генератора, а не сервис\u001b[0m\r\n"]
[41.133385, "o", "\r\n\u001b[32m$ python -m tools.loadtest --scenarios ask --concurrency 1 2 4 --duration 8\u001b[0m\r\n"]
[56.611508, "o", "ask       c=1   RPS    0.29  p50   3553.6  p95   3671.0  p99   3671.0 мс  ошибок 0.0%\r\n"]
[71.799518, "o", "ask       c=2   RPS    0.54  p50   3743.1  p95   4003.4  p99   4003.4 мс  ошибок 0.0%\r\n"]
[99.864951, "o", "ask       c=4   RPS    0.30  p50  13062.2  p95  13253.6  p99  13253.6 мс  ошибок 0.0%\r\n"]
[102.425224, "o", "\u001b[2m# RPS перестаёт расти уже на четырёх клиентах, а p50 уходит вчетверо\u001b[0m\r\n"]
[103.227746, "o", "\u001b[2m# причина не в приложении: инференс один на всех, очередь стоит перед ним\u001b[0m\r\n"]
[104.029857, "o", "\u001b[2m# отсюда и вывод отчёта — масштабировать надо карты, а не реплики сервиса\u001b[0m\r\n"]
[104.831865, "o", "\r\n\u001b[1m\u001b[32mГотово.\u001b[0m\r\n"]
