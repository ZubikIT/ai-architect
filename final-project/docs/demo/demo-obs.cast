{"version": 2, "width": 100, "height": 34, "timestamp": 1789736222, "env": {"SHELL": "/bin/bash", "TERM": "tmux-256color"}}
[0.013941, "o", "\u001b[H\u001b[J\u001b[3J"]
[0.015024, "o", "\u001b[1m\u001b[36mНаблюдаемость закрытого контура\u001b[0m\r\n\u001b[2m# развёрнутый стек: Neo4j, Jaeger, VictoriaMetrics, Grafana\u001b[0m\r\n"]
[0.816442, "o", "\u001b[2m# данные настоящие — ничего не поднимается на время записи\u001b[0m\r\n"]
[1.618587, "o", "\r\n\u001b[1m\u001b[36m1. Граф связей живёт в самой Neo4j, а не в памяти процесса\u001b[0m\r\n"]
[2.820564, "o", "\r\n\u001b[32m$ cypher-shell 'MATCH ()-[r]->() RETURN type(r), count(*)'\u001b[0m\r\n"]
[6.101374, "o", "ребро, сколько\r\n\"ДОСТУПЕН_РОЛИ\", 29\r\n"]
[6.101563, "o", "\"СОДЕРЖИТ\", 19\r\n"]
[6.101643, "o", "\"ССЫЛАЕТСЯ_НА\", 3\r\n\"ОТМЕНЯЕТ\", 1\r\n"]
[7.8685, "o", "\u001b[2m# ОТМЕНЯЕТ всего одно — но именно оно меняет ответ\u001b[0m\r\n"]
[8.670616, "o", "\r\n\u001b[1m\u001b[36m2. Ребро, которое меняет ответ\u001b[0m\r\n"]
[9.872536, "o", "\r\n\u001b[32m$ cypher-shell 'MATCH (a:Чанк)-[:ОТМЕНЯЕТ]->(b:Чанк) RETURN ...'\u001b[0m\r\n"]
[12.950088, "o", "отменяющий, отменённый\r\n"]
[12.951104, "o", "\"ЛПА-04 · 1. Продолжительность отпуска\", \"ЛПА-01 · 1. Продолжительность отпуска\"\r\n"]
[14.705425, "o", "\u001b[2m# ЛПА-04 отменяет норму ЛПА-01 — текстуально эти куски непохожи\u001b[0m\r\n"]
[15.507421, "o", "\u001b[2m# поэтому гарантии попасть в top-k у отмены нет, её приносит обход\u001b[0m\r\n"]
[16.309824, "o", "\r\n\u001b[1m\u001b[36m3. Права лежат на узлах графа, а не поверх готовой выдачи\u001b[0m\r\n"]
[17.511801, "o", "\r\n\u001b[32m$ cypher-shell 'MATCH (c:Чанк {doc_code:\"ЛПА-03\"})-[:ДОСТУПЕН_РОЛИ]->(r:Роль) ...'\u001b[0m\r\n"]
[20.726757, "o", "раздел, роли\r\n"]
[20.728073, "o", "\"ЛПА-03. Регламент доступа к персональным данным (ограниченный)\", [\"legal\", \"security\"]\r\n"]
[20.728175, "o", "\"1. Назначение\", [\"legal\", \"security\"]\r\n"]
[20.728308, "o", "\"2. Принцип минимальных привилегий\", [\"legal\", \"security\"]\r\n"]
[20.728397, "o", "\"3. Аудит доступа\", [\"security\", \"legal\"]\r\n"]
[20.728602, "o", "\"4. Трансграничная передача\", [\"security\", \"legal\"]\r\n"]
[22.483832, "o", "\u001b[2m# роли all среди них нет — для неё этих узлов не существует\u001b[0m\r\n"]
[23.285853, "o", "\r\n\u001b[1m\u001b[36m4. Критерий ТЗ: один вопрос, две роли\u001b[0m\r\n"]
[24.487916, "o", "\r\n\u001b[32m$ curl -s $API/ask -d '{\"question\":\"…ПДн командированного…\",\"roles\":[\"all\"]}'\u001b[0m\r\n"]
[27.578545, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"роль\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"all\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"источники\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[0;32m\"ЛПА-01\"\u001b[0m\u001b[1;39m,\u001b[0;32m\"ЛПА-02\"\u001b[0m\u001b[1;39m,\u001b[0;32m\"ЛПА-04\"\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[28.781197, "o", "\r\n\u001b[32m$ curl -s $API/ask -d '{\"question\":\"…ПДн командированного…\",\"roles\":[\"legal\"]}'\u001b[0m\r\n"]
[32.937913, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"роль\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"legal\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"источники\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[0;32m\"ЛПА-01\"\u001b[0m\u001b[1;39m,\u001b[0;32m\"ЛПА-02\"\u001b[0m\u001b[1;39m,\u001b[0;32m\"ЛПА-03\"\u001b[0m\u001b[1;39m,\u001b[0;32m\"ЛПА-04\"\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[34.140779, "o", "\u001b[2m# закрытый ЛПА-03 появился только у legal — и не транзитом по ссылке\u001b[0m\r\n"]
[34.943051, "o", "\r\n\u001b[1m\u001b[36m5. Тот же запрос в Jaeger: request_id это и есть trace_id\u001b[0m\r\n"]
[39.33818, "o", "\r\n\u001b[32m$ request_id = c29ca3e304624ece9344536f3a8f6a3c\u001b[0m\r\n\u001b[2m# ждём, пока спаны доедут до Jaeger\u001b[0m\r\n"]
[39.550777, "o", "."]
[41.766807, "o", "."]
[43.974267, "o", "."]
[46.089639, "o", "\r\n"]
[46.089684, "o", "\r\n\u001b[32m$ python3 jaeger_tree.py $request_id     # то же дерево, что рисует UI\u001b[0m\r\n"]
[47.105867, "o", "ask                         3177.1 мс\r\n  guardrail.input              0.0 мс\r\n  retrieve                   808.0 мс\r\n    retrieve.hybrid          802.2 мс\r\n"]
[47.106238, "o", "      retrieve.embed          36.9 мс\r\n      retrieve.dense           3.8 мс\r\n      retrieve.bm25            0.2 мс\r\n      retrieve.rerank        760.5 мс\r\n    graph.expand               3.2 мс\r\n    graph.annotate             2.2 мс\r\n"]
[47.106285, "o", "  llm.generate              2368.3 мс\r\n  guardrail.output             0.1 мс\r\n"]
[49.12141, "o", "\u001b[2m# время съедают реранк и генерация; обход графа — единицы миллисекунд\u001b[0m\r\n"]
[49.923394, "o", "\u001b[2m# содержимое запроса в трейс не пишется: там имена шагов и длительности\u001b[0m\r\n"]
[50.725425, "o", "\r\n\u001b[1m\u001b[36m6. Метрики, на которых стоят алерты\u001b[0m\r\n"]
[51.927504, "o", "\r\n\u001b[32m$ VictoriaMetrics /api/v1/query\u001b[0m\r\n"]
[52.829594, "o", "  пометка об отмене, доля "]
[52.842822, "o", "0.9545454545454546\r\n"]
[53.345076, "o", "  вклад графа, доля  "]
[53.359872, "o", "1\r\n"]
[53.862401, "o", "  обход графа p95, с    "]
[53.87506, "o", "0.023249999999999993\r\n"]
[54.377577, "o", "  ответ p95, с (без /healthz) "]
[54.391388, "o", "5.299999999999997\r\n"]
[54.893592, "o", "  доля ошибок            "]
[54.905022, "o", "0.09592326139088729\r\n"]
[55.408018, "o", "  нарушений ACL           "]
[55.419363, "o", "0\r\n"]
[55.92303, "o", "  честных отказов    "]
[55.940814, "o", "6\r\n"]
[57.945053, "o", "\u001b[2m# первые две ловят «граф перестал работать» — падение доли видно раньше жалоб\u001b[0m\r\n"]
[58.747308, "o", "\u001b[2m# в демо-корпусе она около единицы: он построен вокруг отменённой нормы\u001b[0m\r\n"]
[59.549693, "o", "\u001b[2m# отказы в знаменатель не входят — отказ не считается ответом\u001b[0m\r\n"]
[60.351879, "o", "\u001b[2m# p95 считается без /healthz: 171 проверка против 21 запроса занижала его в 58 раз\u001b[0m\r\n"]
[61.154562, "o", "\r\n\u001b[1m\u001b[36m7. Чего здесь нет и почему\u001b[0m\r\n"]
[62.356701, "o", "\u001b[2m# guardrails и отклонённые токены — счётчики слоя платформы, не контура\u001b[0m\r\n"]
[63.159279, "o", "\u001b[2m# пустая панель это не ноль, и выдавать её за ноль нельзя\u001b[0m\r\n"]
[63.961794, "o", "\u001b[2m# логи vLLM снимаются с GPU-бокса: снаружи в него хода нет по построению\u001b[0m\r\n"]
[64.764001, "o", "\r\n\u001b[1m\u001b[32mГотово.\u001b[0m\r\n"]
