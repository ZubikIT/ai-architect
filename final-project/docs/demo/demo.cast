[0.039085, "o", "\u001b[H\u001b[J\u001b[3J"]
[0.039784, "o", "\u001b[1m\u001b[36mМультиагентная платформа цифровых корпоративных сотрудников\u001b[0m\r\n\u001b[2m# закрытый контур: свои модели, свой инференс, нулевой egress\u001b[0m\r\n"]
[0.741409, "o", "\u001b[2m# демонстрация офлайн — GPU не нужен, граф и права работают полностью\u001b[0m\r\n"]
[1.443562, "o", "\r\n\u001b[1m\u001b[36m1. Поднимаем сервис\u001b[0m\r\n"]
[2.445701, "o", "\r\n\u001b[32m$ uvicorn sufler.api:app --port 34963\u001b[0m\r\n"]
[2.445999, "o", "\u001b[2m# ждём готовности\u001b[0m "]
[2.457316, "o", "."]
[3.468608, "o", "."]
[4.500027, "o", "\r\n"]
[4.500162, "o", "\r\n\u001b[32m$ curl -s http://127.0.0.1:34963/healthz | jq -c\u001b[0m\r\n"]
[5.316185, "o", "{\"status\":\"ok\",\"auth\":\"dev\",\"rerank\":\"local\"}\r\n"]
[6.518501, "o", "\u001b[2m# auth=dev — режим доступа виден снаружи намеренно:\u001b[0m\r\n"]
[7.220433, "o", "\u001b[2m# dev-режим, о котором не знают, это открытый контур, который считают закрытым\u001b[0m\r\n"]
[7.922568, "o", "\r\n\u001b[1m\u001b[36m2. Граф связей собран поверх корпуса\u001b[0m\r\n"]
[8.924778, "o", "\r\n\u001b[32m$ curl -s http://127.0.0.1:34963/graph/stats | jq -c\u001b[0m\r\n"]
[30.323362, "o", "{\"backend\":\"in-memory\",\"nodes\":19,\"documents\":4,\"edges\":4,\"cancels\":1,\"references\":3}\r\n"]
[31.525833, "o", "\u001b[2m# 4 ребра на 19 узлах: одна отмена и три ссылки\u001b[0m\r\n"]
[32.228047, "o", "\r\n\u001b[1m\u001b[36m3. Вопрос, на котором вектор ошибается\u001b[0m\r\n"]
[33.230202, "o", "\r\n\u001b[32m$ curl -s http://127.0.0.1:34963/ask -H 'Content-Type: application/json' \\\r\n    -d '{\"question\":\"Сколько дней основной ежегодный отпуск?\"}' \\\r\n    | jq '{answer: .answer[0:200], graph_notes, sources: [.sources[].doc_code]}'\u001b[0m\r\n"]
[34.964577, "o", "{\r\n  \"answer\": \"(демо без LLM) Наиболее релевантный пункт:\\n\\n## 1. Продолжительность отпуска\\nОсновной ежегодный трудовой отпуск составляет 28 календарных дней. Отдельным категориям работников предоставляется дополните\",\r\n  \"graph_notes\": [\r\n    \"ЛПА-01 «1. Продолжительность отпуска» отменён документом ЛПА-04 · 1. Продолжительность отпуска\"\r\n  ],\r\n  \"sources\": [\r\n    \"ЛПА-01\",\r\n    \"ЛПА-04\",\r\n    \"ЛПА-02\",\r\n    \"ЛПА-01\",\r\n    \"ЛПА-01\"\r\n  ]\r\n}\r\n"]
[36.167107, "o", "\u001b[2m# вектор нашёл ЛПА-01 с 28 днями — пометку об отмене принёс обход графа\u001b[0m\r\n"]
[36.869086, "o", "\r\n\u001b[1m\u001b[36m4. Контрольный замер: тот же вопрос без графа\u001b[0m\r\n"]
[37.871404, "o", "\u001b[2m# граф выключается переменной окружения, остальной путь не меняется\u001b[0m\r\n"]
[38.573797, "o", "\r\n\u001b[32m$ SUFLER_GRAPH=0 .venv/bin/python -c \"\r\nfrom sufler.rag import Sufler\r\nr = Sufler().answer('Сколько дней основной ежегодный отпуск?', ['all'], 'demo')\r\nprint('пометок:', r['graph_notes'] or 'НЕТ')\r\nprint(r['answer'][:150])\"\u001b[0m\r\n"]
[64.609147, "o", "пометок: НЕТ\r\n(демо без LLM) Наиболее релевантный пункт:\r\n## 1. Продолжительность отпуска\r\nОсновной ежегодный трудовой отпуск составляет 28 календарных дней. Отдельн\r\n"]
[65.811443, "o", "\u001b[2m# пометки нет — ответ выглядит так же уверенно и он неверен\u001b[0m\r\n"]
[66.513442, "o", "\r\n\u001b[1m\u001b[36m5. Критерий ТЗ: пользователь B не получает закрытый документ\u001b[0m\r\n"]
