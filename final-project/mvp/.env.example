# LLM — OpenAI-совместимый эндпоинт (в проде: vLLM + Qwen3.6, ADR-0002/0003)
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=not-needed
SUFLER_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# 0 = офлайн-демо без LLM (extractive fallback), 1 = с LLM
SUFLER_USE_LLM=1

# данные и модели
SUFLER_DATA_DIR=data/lpa
SUFLER_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
SUFLER_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# retrieval (урок 06)
SUFLER_TOP_K=20
SUFLER_TOP_CTX=5
