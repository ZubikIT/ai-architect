# Singleuser-образ для DockerSpawner.
# База: jupyter/minimal-notebook (уже включает Jupyter, ipykernel, conda).
# Поверх: пиннинг langgraph/langchain под ДЗ-07 + клон архитекторского репо в /home/jovyan/architect.
FROM jupyter/minimal-notebook:python-3.11

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl \
    && rm -rf /var/lib/apt/lists/*

USER ${NB_UID}

# Versions матчат то, на чём прогонял локально и в CI — чтобы преподаватель не словил breakage 0.5↔0.6.
RUN pip install --no-cache-dir \
    "langgraph>=0.2,<1.0" \
    "langchain-core>=0.3,<1.0" \
    "langchain-openai>=0.2,<1.0" \
    grandalf jupyterhub

# read-only слепок архитекторского репо: даже если репо станет приватным/упадёт,
# у юзера локально есть ipynb рядом со средой.
RUN git clone --depth=1 https://gitlab.com/artcloud/ai/architect.git \
        /home/jovyan/architect \
    && chown -R ${NB_UID}:${NB_GID} /home/jovyan/architect

WORKDIR /home/jovyan/work

# Сразу копнём ipynb из репо в work/, чтобы пользователь видел его первым делом.
RUN cp /home/jovyan/architect/02-architecture/homework/07-ai-agents.ipynb \
       /home/jovyan/work/07-ai-agents.ipynb
