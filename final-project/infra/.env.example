# Секреты для локального запуска. В контуре значения приходят из Vault (ADR-0001).
NEO4J_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
GRAFANA_PASSWORD=change-me

# Внешний vLLM (GPU-нода). Для офлайн-демо без LLM: SUFLER_USE_LLM=0
OPENAI_BASE_URL=http://host.docker.internal:8000/v1
OPENAI_API_KEY=not-needed
SUFLER_LLM_MODEL=Qwen3.5-27B
SUFLER_USE_LLM=1

# Keycloak: роли берутся из проверенного JWT (ADR-0016).
# Пусто → dev-режим (роли из тела запроса), виден в /healthz как "auth": "dev".
OIDC_JWKS_URL=
OIDC_AUDIENCE=
OIDC_ISSUER=
OIDC_ROLES_CLAIM=groups

# Порты
BACKEND_PORT=8080
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
QDRANT_PORT=6333
JAEGER_UI_PORT=16686
GRAFANA_PORT=3000
VM_PORT=8428
