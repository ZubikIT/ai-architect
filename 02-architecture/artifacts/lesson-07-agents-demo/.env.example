# Provider: yandex | openai
LLM_PROVIDER=yandex

# --- Yandex Cloud / Yandex AI Studio (OpenAI-compatible API) ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_MODEL=yandexgpt-lite

# --- OpenAI (or any OpenAI-compatible endpoint) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# --- Per-role model overrides (optional) ---
# SUPERVISOR_MODEL=
# WORKER_MODEL=
# SUMMARY_MODEL=

# --- HTTP timeouts / retries ---
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
