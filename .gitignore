# Большие бинарники — храним в S3, не в git
*.mp4
# Исключение: видео-демо финального проекта — требование формата сдачи по ТЗ,
# 5,6 МБ. Комиссия должна получить его вместе с репозиторием, а не собирать
# из .cast. Широкая версия; 64-колоночная идёт на витрину как .cast.
!final-project/docs/demo/demo.mp4
!final-project/docs/demo/demo-obs.mp4
*.mov
*.avi
*.zip
*.tar.gz
*.iso

# MkDocs: docs/ и public/ генерируются в CI (scripts/build-docs.sh)
/docs/
/public/
/site/

# Локальные черновики
scratch/
tmp/
.tmp/
*.draft.md

# Structurizr Lite runtime workdir (auto-generated cache + workspace.json)
**/artifacts/structurizr/

# OTUS — материалы курса (xlsx/docx/pptx) коммитим вместе с уроками.
# Не-для-публикации складываем только сюда:
otus-originals/

# Сборка слайдов: HTML — промежуточный артефакт (картинки встроены base64,
# файл на мегабайты). В git идут исходник .md и готовый .pdf.
final-project/docs/presentation.html
zubriq-platform/docs/presentation.html
